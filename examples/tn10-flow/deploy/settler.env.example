# ZKas L2 settler (tn10-flow) configuration. Copy to /etc/zkas-settler/settler.env and edit.
# Required.

# wRPC (Borsh) endpoint of an L1 node. The node must be started with --rpclisten-borsh
# (default Borsh port 17810 for ZKas mainnet); gRPC 16110 alone is not enough.
TN10_WRPC_URL=ws://127.0.0.1:17810

# Hex-encoded secp256k1 private key that funds the covenant and signs L1 carrier transactions.
TN10_PRIVATE_KEY=

# Network id the wRPC client binds to.
TN10_NETWORK=mainnet

# --- Mode -----------------------------------------------------------------------------------
# Unset / 0: execution-only. Tracks the decoded state counter, reorgs, and settlements. Light.
# 1: proving + settlement. Drives the full transaction/batch/aggregate prover stack and lands
#    settlements on L1. Real (secure) proofs need a CUDA build and RISC0_DEV_MODE unset; without
#    a GPU, leave this at 0 or run with RISC0_DEV_MODE=1 for dev-mode (non-secure) proofs.
TN10_SETTLE=0
# RISC0_DEV_MODE=1

# --- Covenant -------------------------------------------------------------------------------
# Leave both unset to bootstrap a NEW covenant on first run (the id is logged and persisted under
# TN10_DATA_DIR). To attach to an existing covenant, set both:
# TN10_COVENANT_ID=<32-byte hex>
# TN10_START_FROM=<L1 daa score / block to replay forward from>

# --- Optional tuning ------------------------------------------------------------------------
TN10_DATA_DIR=/var/lib/zkas-settler
# TN10_LANE_ID=
# TN10_ACTIVITY_COUNT=
# TN10_ACTIVITY_INTERVAL_MS=
# TN10_SEED_DEPTH=
